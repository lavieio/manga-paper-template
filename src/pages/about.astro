---
/**
 * 关于页：壳。
 *
 * 正文全部来自 `src/content/pages/about.md`（Markdown、HTML、`<style>` 都能写），
 * 这里只做三件事：套 Base 布局、渲染 frontmatter 的标题当 h1、把正文放进 `.about-custom`。
 * 用户的 `<style>` 由 `scopeCustomStyles()` 包进 `@scope`，样式漏不到页头页脚。
 */
import "../styles/prose.css";
import { getEntry, render } from "astro:content";
import { experimental_AstroContainer as AstroContainer } from "astro/container";
import Base from "../layouts/Base.astro";
import { site } from "../config";
import { getPublishedPosts, siteStats } from "../utils/content/posts";
import { CUSTOM_SCOPE_CLASS, scopeCustomStyles } from "../utils/content/about";

const entry = await getEntry("pages", "about");
if (!entry) throw new Error("[about] 缺少 src/content/pages/about.md");

const { Content } = await render(entry);
// 拿渲染后的 HTML 字符串，才能把用户写的 <style> 包进 @scope
const container = await AstroContainer.create();
const body = scopeCustomStyles(await container.renderToString(Content));

const { title, description, prose, stats: showStats } = entry.data;
// 关掉统计条时不必扫全量文章
const stats = showStats ? siteStats(await getPublishedPosts()) : null;
---

<Base title={title} description={description ?? site.bio}>
  <div class="page-head">
    <h1>{title}</h1>
  </div>

  <article class={prose ? `${CUSTOM_SCOPE_CLASS} prose` : CUSTOM_SCOPE_CLASS} set:html={body} />

  {
    stats && (
      /* role="group"：aria-label 挂在无 role 的 div 上会被 axe 判 aria-prohibited-attr */
      <div class="stats" role="group" aria-label="站点统计">
        <div class="stat"><b>{stats.posts}</b>篇文章</div>
        <div class="stat"><b>{stats.categories}</b>个分类</div>
        <div class="stat"><b>{stats.tags}</b>枚标签</div>
      </div>
    )
  }
</Base>

<style>
  .page-head {
    margin: 8px 0 28px;
  }
  .page-head h1 {
    font-size: 30px;
    font-weight: 700;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 44px;
  }
  .stat {
    padding: 10px 18px;
    border: 3px solid var(--ink);
    background: var(--card);
    box-shadow: var(--shadow);
    font-size: 13px;
  }
  .stat b {
    display: block;
    font-size: 20px;
    line-height: 1.3;
  }
</style>

---
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import FeaturedStack from "../components/FeaturedStack.astro";
import { site } from "../config";
import { getPublishedPosts, siteStats } from "../utils/posts";
import { blogJsonLd, siteFacts, websiteJsonLd } from "../utils/structured-data";

const RECENT_COUNT = 3;

const posts = await getPublishedPosts();
const featured = posts.filter((p) => p.data.featured);
const recent = posts.filter((p) => !p.data.featured).slice(0, RECENT_COUNT);
const stats = siteStats(posts);

// 首页承担站点身份：WebSite（站点本体）+ Blog（博客本体）两个节点
const jsonLdSite = siteFacts(site, Astro.site);
const jsonLd = [websiteJsonLd(jsonLdSite), blogJsonLd(jsonLdSite)];
---

<Base structuredData={jsonLd}>
  {/* 首页按设计没有可见标题（demo 也没有），但 h1 得有一个：
      否则 axe 报 page-has-heading-one，读屏用户也拿不到站点身份 */}
  <h1 class="sr-only">{site.name} · {site.tagline}</h1>

  {/* 精选统一由 FeaturedStack 渲染；单篇时组件内部降级为单张大卡 */}
  {featured.length > 0 && <FeaturedStack posts={featured} />}

  <div class="sec-head">
    <span class="sticker yellow">最近更新</span>
    <span class="rule"></span>
  </div>
  <section class="cards">
    {recent.map((post) => <PostCard post={post} />)}
  </section>

  <div class="actions">
    <a class="btn" href="/posts/1">查看全部文章 →</a>
  </div>

  {/* role="group"：aria-label 挂在无 role 的 div 上会被 axe 判 aria-prohibited-attr（与 /about 的统计条一致） */}
  <div class="stats" role="group" aria-label="站点统计">
    <div class="stat"><b>{stats.posts}</b>篇文章</div>
    <div class="stat"><b>{stats.categories}</b>个分类</div>
    <div class="stat"><b>{stats.tags}</b>枚标签</div>
  </div>
</Base>

<style>
  .sec-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 56px 0 22px;
  }
  .sec-head .rule {
    flex: 1;
    height: 3px;
    background: var(--ink);
  }
  .cards {
    display: grid;
    gap: 26px;
  }
  .actions {
    margin-top: 32px;
    display: flex;
    justify-content: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 600;
    border: 3px solid var(--ink);
    box-shadow: var(--shadow);
    background: var(--yellow);
    color: var(--on-light-fill);
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  .btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lg);
  }
  .btn:active {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ink);
  }
  .stats {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin: 64px 0 30px;
  }
  .stat {
    border: 3px solid var(--ink);
    background: var(--card);
    box-shadow: var(--shadow);
    padding: 10px 18px;
    font-size: 13px;
  }
  .stat b {
    font-size: 20px;
    display: block;
    line-height: 1.3;
  }

  .sticker {
    display: inline-block;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    color: var(--on-light-fill);
  }
  .sticker.yellow { background: var(--yellow); transform: rotate(-1deg); }
</style>

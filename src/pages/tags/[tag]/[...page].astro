---
/**
 * 标签页：`/tags/<标签>/`（第 1 页）与 `/tags/<标签>/<N>/`（第 2 页起）。
 * 与分类页同一套分页（`posts.perPage`），只是标题前缀、贴纸底色与返回链接不同。
 */
import Base from "../../../layouts/Base.astro";
import TaxonomyList from "../../../components/TaxonomyList.astro";
import { posts as postsConfig } from "../../../config";
import { getPublishedPosts, tagUrl } from "../../../utils/content/posts";
import type { GetStaticPathsOptions } from "astro";

export const PAGE_SIZE = postsConfig.perPage;

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.flatMap((tag) =>
    paginate(
      posts.filter((post) => post.data.tags.includes(tag)),
      { pageSize: PAGE_SIZE, params: { tag }, props: { tag } },
    ),
  );
}

const { tag, page } = Astro.props;
---

<Base
  title={`标签 · ${tag}${page.currentPage === 1 ? "" : ` · 第 ${page.currentPage} 页`}`}
  description={`标签「${tag}」下的 ${page.total} 篇文章，按发布时间倒序。`}
>
  <TaxonomyList
    heading={`# ${tag}`}
    count={page.total}
    accent="cyan"
    backHref="/tags/"
    backLabel="← 全部标签"
    page={page}
    base={tagUrl(tag)}
  />
</Base>

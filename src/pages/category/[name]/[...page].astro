---
/**
 * 分类页：`/category/<分类>/`（第 1 页）与 `/category/<分类>/<N>/`（第 2 页起）。
 * 路由是 rest 参数，`paginate()` 才知道要按 `posts.perPage` 切页；`name` 由父段带进来。
 */
import Base from "../../../layouts/Base.astro";
import ArticleList from "../../../components/ArticleList.astro";
import { posts as postsConfig } from "../../../config";
import { getPublishedPosts, getCategory, categoryUrl } from "../../../utils/content/posts";
import type { GetStaticPathsOptions } from "astro";

export const PAGE_SIZE = postsConfig.perPage;

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedPosts();
  const names = [...new Set(posts.map(getCategory))];
  return names.flatMap((name) =>
    paginate(
      posts.filter((post) => getCategory(post) === name),
      { pageSize: PAGE_SIZE, params: { name }, props: { name } },
    ),
  );
}

const { name, page } = Astro.props;
---

<Base
  title={`分类 · ${name}${page.currentPage === 1 ? "" : ` · 第 ${page.currentPage} 页`}`}
  description={`分类「${name}」下的 ${page.total} 篇文章，按发布时间倒序。`}
>
  <ArticleList
    heading={name}
    count={page.total}
    page={page}
    base={categoryUrl(name)}
    backHref="/categories/"
    backLabel="← 全部分类"
    showPageNote
  />
</Base>

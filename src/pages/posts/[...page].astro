---
import Base from "../../layouts/Base.astro";
import ArticleList from "../../components/ArticleList.astro";
import { posts as postsConfig } from "../../config";
import { getPublishedPosts } from "../../utils/content/posts";
import type { GetStaticPathsOptions } from "astro";

export const PAGE_SIZE = postsConfig.perPage;

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: PAGE_SIZE });
}

const { page } = Astro.props;
---

<Base
  title={page.currentPage === 1 ? "全部文章" : `全部文章 · 第 ${page.currentPage} 页`}
  description={`共 ${page.total} 篇文章（每页 ${PAGE_SIZE} 篇），这是第 ${page.currentPage} / ${page.lastPage} 页。`}
>
  <ArticleList heading="全部文章" count={page.total} page={page} base="/posts/" showPageNote />
</Base>

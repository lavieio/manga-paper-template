---
import "../../styles/prose.css";
import { render } from "astro:content";
import { experimental_AstroContainer as AstroContainer } from "astro/container";
import Base from "../../layouts/Base.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import BackToTop from "../../components/BackToTop.astro";
import Comments from "../../components/Comments.astro";
import PrivateUnlock from "../../components/PrivateUnlock.astro";
import { site, categoryColors } from "../../config";
import { encryptText, getPrivatePassword, type EncryptedPayload } from "../../utils/crypto/private-crypto";
import {
  getPublishedPosts,
  getPostSlug,
  getCategory,
  categoryUrl,
  tagUrl,
  postUrl,
} from "../../utils/content/posts";
import { categoryColor } from "../../utils/content/category";
import { estimateReadTime } from "../../utils/content/readtime";
import { formatDate } from "../../utils/content/format";
import { blogPostingJsonLd, siteFacts } from "../../utils/content/structured-data";
import { postShareImage } from "../../utils/og/share";

export async function getStaticPaths() {
  // 详情页路由取全量（含私密；dev 下也含草稿）；上一篇/下一篇只取公开文章（生产构建不含草稿）
  const [all, publicOnly] = await Promise.all([
    getPublishedPosts({ includePrivate: true }),
    getPublishedPosts(),
  ]);
  return all.map((post) => {
    const pubIdx = publicOnly.findIndex((p) => p.id === post.id);
    return {
      params: { slug: getPostSlug(post) },
      props: {
        post,
        prev: pubIdx >= 0 ? (publicOnly[pubIdx + 1] ?? null) : null,
        next: pubIdx >= 0 ? (publicOnly[pubIdx - 1] ?? null) : null,
      },
    };
  });
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const category = getCategory(post);
const categoryStickerColor = categoryColor(category, categoryColors);
const minutes = estimateReadTime(post.body ?? "");

// 私密文章：构建期加密正文——同一条渲染管线，只存密文
let privatePayload: EncryptedPayload | null = null;
if (post.data.private) {
  const container = await AstroContainer.create();
  const html = await container.renderToString(Content);
  privatePayload = await encryptText(html, getPrivatePassword(post.id));
}

// 私密文章不输出 JSON-LD：标题/描述按设计不能出现在明文里
// 分享图：私密文章的标题不能进图，postShareImage() 会回落站点默认卡片
const shareImage = postShareImage(
  { slug: getPostSlug(post), title: post.data.title, cover: post.data.cover, isPrivate: !!privatePayload },
  { siteUrl: Astro.site, siteName: site.name },
);

const jsonLd = privatePayload
  ? undefined
  : blogPostingJsonLd(
      {
        url: new URL(postUrl(post), Astro.site).href,
        title: post.data.title,
        description: post.data.description,
        published: post.data.date,
        updated: post.data.updated,
        section: category,
        keywords: post.data.tags,
      },
      siteFacts(site, Astro.site),
    );
---

<Base
  title={privatePayload ? "私密文章" : post.data.title}
  description={privatePayload ? "这篇内容已加密" : post.data.description}
  noindex={!!privatePayload || post.data.draft}
  unlockCheck={!!privatePayload}
  searchable={!privatePayload && !post.data.draft}
  structuredData={jsonLd}
  shareImage={shareImage}
  shareType="article"
>
  {import.meta.env.DEV && post.data.draft && (
    <div class="draft-banner">
      <b>草稿预览</b>
      <span>这篇内容只在开发环境可见，生产构建不会包含。</span>
    </div>
  )}
  {
    privatePayload ? (
      <>
        {/* 正文是密文、标题按设计不进明文（verify 有「私密文章零明文」断言），
            所以这里的 h1 只能是通用标签——不能写 post.data.title */}
        <h1 class="sr-only">私密文章</h1>
        <article class="prose" data-private-article data-pagefind-ignore hidden />
        <PrivateUnlock payload={privatePayload} />
        <TableOfContents headings={[]} defer />
        <BackToTop />
      </>
    ) : (
      <>
        <div class="post-head">
          <div class="stickers">
            {post.data.draft && <span class="sticker red">草稿</span>}
            <a class={`sticker ${categoryStickerColor}`} href={categoryUrl(category)}>
              {category}
            </a>
            {
              post.data.tags.map((tag: string) => (
                <a class="sticker blue" href={tagUrl(tag)}>
                  {tag}
                </a>
              ))
            }
          </div>
          <h1 class="post-title">{post.data.title}</h1>
          <div class="post-meta">
            <span>发布 <b>{formatDate(post.data.date)}</b></span>
            {post.data.updated && <span>更新 <b>{formatDate(post.data.updated)}</b></span>}
            <span>约 <b>{minutes} 分钟</b></span>
          </div>
        </div>

        <article class="prose" data-pagefind-body>
          {/* Pagefind 元数据需在 body 内：搜索结果卡片用它显示分类贴纸 */}
          <span data-pagefind-meta="category" hidden>{category}</span>
          <span data-pagefind-meta="color" hidden>{categoryStickerColor}</span>
          <Content />
        </article>

        <nav class="post-nav">
          {
            prev ? (
              <a class="nav-card" href={postUrl(prev)}>
                <div class="lbl">← 上一篇</div>
                <b>{prev.data.title}</b>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a class="nav-card next" href={postUrl(next)}>
                <div class="lbl">下一篇 →</div>
                <b>{next.data.title}</b>
              </a>
            )
          }
        </nav>

        <Comments />

        {/* TOC 悬浮于容器右缘外侧（≥1400px 才显示），不占正文栏位 */}
        <TableOfContents headings={headings} />

        <BackToTop />
      </>
    )
  }
</Base>

<style>
  .stickers a.sticker {
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  .stickers a.sticker:hover {
    box-shadow: 4px 4px 0 var(--ink);
  }
  .draft-banner {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
    margin: 18px 0 0;
    padding: 10px 14px;
    border: 3px dashed var(--red-ink);
    background: var(--paper);
    box-shadow: var(--shadow);
    font-size: 13px;
    color: var(--ink-soft);
  }
  .draft-banner b {
    color: var(--red-ink);
  }
</style>

<script>
  import { initLightbox } from "../../scripts/lightbox";
  import { initCodeCopy } from "../../scripts/code-copy";
  initLightbox();
  initCodeCopy();
</script>

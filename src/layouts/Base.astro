---
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/card.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../config";
import { FONT_PRELOAD } from "../utils/font-assets";
import { serializeJsonLd, type JsonLdNode } from "../utils/structured-data";

interface Props {
  title?: string;
  description?: string;
  /** 私密文章等不希望被索引的页面 */
  noindex?: boolean;
  /** 私密页面：首帧前同步检查解锁缓存，避免密码框闪烁 */
  unlockCheck?: boolean;
  /**
   * 可被 Pagefind 索引（仅公开文章页设 true）。
   * 其余页面整个 body 标 data-pagefind-ignore：
   * 否则当站内没有任何 data-pagefind-body 时，Pagefind 会退化成索引全部页面。
   */
  searchable?: boolean;
  /** schema.org 结构化数据（JSON-LD）；不传就不渲染（私密文章必须不传） */
  structuredData?: JsonLdNode | readonly JsonLdNode[];
}

const {
  title,
  description = site.tagline,
  noindex = false,
  unlockCheck = false,
  searchable = false,
  structuredData,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
// RSS auto-discovery（plan §12）：阅读器 / 浏览器扩展靠这条声明自动发现订阅地址
const rssFeed = new URL("rss.xml", Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      unlockCheck && (
        <script is:inline>
          // 首帧前检查解锁缓存：有密钥则直接标记，CSS 立即隐藏密码框（防闪烁）
          try {
            if (localStorage.getItem("mangapaper:private-key")) {
              document.documentElement.dataset.unlocked = "1";
            }
          } catch (e) {}
        </script>
      )
    }
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={rssFeed} />
    {
      structuredData && (
        <script type="application/ld+json" is:inline set:html={serializeJsonLd(structuredData)} />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/*
      字体 preload（P1-1）：自托管子集只 preload core 的 400 / 700（正文 + 标题），
      其余字重与 tail 分片交给 unicode-range 按需取；清单来自构建期生成的 font-assets.ts。
      `as="font"` 的 preload 一律走 CORS 模式，同源也必须写 crossorigin，否则会被取两次。
    */}
    {
      FONT_PRELOAD.map((href) => (
        <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={href} />
      ))
    }
    <script is:inline>
      // 首帧前决定主题，避免 FOUC（plan §4.3）
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch (e) {}
        var theme =
          saved === "dark" || saved === "light"
            ? saved
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body data-pagefind-ignore={searchable ? undefined : ""}>
    {/*
      跳过链接（P3-1）：键盘用户 Tab 第一下就直达正文，不必每次穿过页头那串导航。
      未聚焦时与 .sr-only 一样藏着（仍在无障碍树里），聚焦后在页内左上角现身。
    */}
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="wrap">
      <SiteHeader current={Astro.url.pathname} />
      {/* tabindex="-1"：跳到正文后焦点要真的落到这里，否则只滚屏幕、读屏还停在导航上（不占 Tab 顺序） */}
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

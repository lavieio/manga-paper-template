---
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/card.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../config";
import { FONT_PRELOAD, FONT_TAIL_CSS } from "../utils/font-assets";
import { serializeJsonLd, type JsonLdNode } from "../utils/structured-data";
import { siteShareImage, type ShareImage } from "../utils/share-image";

interface Props {
  title?: string;
  description?: string;
  /** 私密文章等不希望被索引的页面 */
  noindex?: boolean;
  /** 私密页面：首帧前同步检查解锁缓存，避免密码框闪烁 */
  unlockCheck?: boolean;
  /**
   * 可被 Pagefind 索引（仅公开文章页设 true）。
   * 其余页面整个 body 标 data-pagefind-ignore：
   * 否则当站内没有任何 data-pagefind-body 时，Pagefind 会退化成索引全部页面。
   */
  searchable?: boolean;
  /** schema.org 结构化数据（JSON-LD）；不传就不渲染（私密文章必须不传） */
  structuredData?: JsonLdNode | readonly JsonLdNode[];
  /** 分享图（og:image）；文章页传自己的卡片，其余页面用站点默认卡片 */
  shareImage?: ShareImage;
  /** og:type：文章页给 article，其余页面给 website */
  shareType?: "website" | "article";
}

const {
  title,
  description = site.tagline,
  noindex = false,
  unlockCheck = false,
  searchable = false,
  structuredData,
  shareImage = siteShareImage({ siteUrl: Astro.site, siteName: site.name }),
  shareType = "website",
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.name;
// og:title 不带「· 站点名」后缀：平台会自己补站点信息，重复一遍反而变长
const shareTitle = title ?? site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
// RSS auto-discovery：阅读器 / 浏览器扩展靠这条声明自动发现订阅地址
const rssFeed = new URL("rss.xml", Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      unlockCheck && (
        <script is:inline>
          // 首帧前检查解锁缓存：有密钥则直接标记，CSS 立即隐藏密码框（防闪烁）
          try {
            if (localStorage.getItem("mangapaper:private-key")) {
              document.documentElement.dataset.unlocked = "1";
            }
          } catch (e) {}
        </script>
      )
    }
    <link rel="canonical" href={canonical} />
    {/*
      分享卡片：og:url 跟随 canonical（同一份地址来源），图片一律绝对地址——
      Open Graph 不接受相对路径，平台会直接丢掉整张图。
    */}
    <meta property="og:type" content={shareType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage.url} />
    {shareImage.width && <meta property="og:image:width" content={String(shareImage.width)} />}
    {shareImage.height && <meta property="og:image:height" content={String(shareImage.height)} />}
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage.url} />
    <meta name="twitter:image:alt" content={shareImage.alt} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={rssFeed} />
    {
      structuredData && (
        <script type="application/ld+json" is:inline set:html={serializeJsonLd(structuredData)} />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/*
      字体 preload：自托管子集只 preload core 的 400 / 700（正文 + 标题），
      其余字重与 tail 分片交给 unicode-range 按需取；清单来自构建期生成的 font-assets.ts。
      `as="font"` 的 preload 一律走 CORS 模式，同源也必须写 crossorigin，否则会被取两次。
    */}
    {
      FONT_PRELOAD.map((href) => (
        <link rel="preload" as="font" type="font/woff2" crossorigin="anonymous" href={href} />
      ))
    }
    {/*
      tail 字面清单：GB2312 一级里 core 之外的剩余字，只在页面真出现那些字时才去取对应 woff2。
      它是一长串 unicode-range（~50 KB），内联进 HTML 等于每个页面都重下一遍，所以出成独立 CSS
      （content-hash 命名 + `/fonts/*` immutable）异步挂载：media=print 不阻塞渲染，load 完切回 all。
      代价是 CSP 得放行内联事件处理器（部署策略里 script-src 已带 'unsafe-inline'）。
      没给 <noscript> 兜底：这份清单只覆盖站点字符集之外的字（构建产物里一个都没出现），
      为它阻塞无 JS 读者的首屏不划算；搜索框里现敲的生僻字在正常（有 JS）路径下已经能兜住。
    */}
    {FONT_TAIL_CSS && <link rel="stylesheet" href={FONT_TAIL_CSS} media="print" onload="this.media='all'" />}
    <script is:inline>
      // 首帧前决定主题，避免 FOUC
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch (e) {}
        var theme =
          saved === "dark" || saved === "light"
            ? saved
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body data-pagefind-ignore={searchable ? undefined : ""}>
    {/*
      跳过链接：键盘用户 Tab 第一下就直达正文，不必每次穿过页头那串导航。
      未聚焦时与 .sr-only 一样藏着（仍在无障碍树里），聚焦后在页内左上角现身。
    */}
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="wrap">
      <SiteHeader current={Astro.url.pathname} />
      {/* tabindex="-1"：跳到正文后焦点要真的落到这里，否则只滚屏幕、读屏还停在导航上（不占 Tab 顺序） */}
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <SiteFooter />
    </div>
  </body>
</html>

---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../config";

interface Props {
  current?: string;
}

const { current = "" } = Astro.props;

/** 站内路由固定，导航也固定在主题里；需要增删入口时直接改这份清单 */
const NAV_ITEMS = [
  { href: "/posts/", matches: ["/posts"], label: "文章" },
  { href: "/archive/", matches: ["/archive"], label: "归档" },
  { href: "/explore/", matches: ["/explore", "/categories", "/category", "/tags"], label: "发现" },
  { href: "/search/", matches: ["/search"], label: "搜索" },
  { href: "/about/", matches: ["/about"], label: "关于" },
] as const;

/** 命中任一前缀即点亮；`/` 只匹配首页，避免把其它页面全点亮 */
function isActive(matches: readonly string[]): boolean {
  return matches.some((match) => {
    if (match === "/") return current === "/";
    return current === match || current === `${match}/` || current.startsWith(`${match}/`);
  });
}
---

<header class="site-header">
  <a class="brand" href="/">
    <span class="seal" aria-hidden="true">{site.sealText}</span>
    <span class="name">{site.name}</span>
  </a>
  <nav class="site-nav" aria-label="主导航">
    {
      NAV_ITEMS.map((item) => {
        const active = isActive(item.matches);
        return (
          <a href={item.href} class={active ? "on" : ""} aria-current={active ? "page" : undefined}>
            {item.label}
          </a>
        );
      })
    }
    <ThemeToggle />
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 34px 0 26px;
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .seal {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    background: var(--red);
    color: var(--on-dark-fill);
    font-size: 17px;
    font-weight: 700;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    transform: rotate(-3deg);
  }
  .brand .name {
    min-width: 0;
    overflow: hidden;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  @media (max-width: 640px) {
    .site-nav {
      gap: 16px;
    }
  }
  .site-nav a {
    font-size: 13px;
    color: var(--ink-soft);
    padding: 3px 1px;
    border-bottom: 3px solid transparent;
  }
  .site-nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--yellow);
  }
  .site-nav a.on {
    color: var(--ink);
    border-bottom-color: var(--red-ink);
  }
</style>

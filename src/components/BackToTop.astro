---
/**
 * 回到顶部（文章详情页专用）
 * - 图标：方形贴纸按钮 + 纸飞机（--blue）＋ 三条漫画速度线；点击时飞机顺速度线射出按钮、拖一条虚线航迹
 * - 位置：<1400px 叠在「目录」悬浮按钮上方；≥1400px 与右栏目录箱同左缘、贴视口底部（--toc-left 见 prose.css）
 * - 无 JS 不渲染（hidden 属性由脚本摘掉）；reduced-motion 下 global.css 已全量关闭动效，滚动也走瞬时
 */
---

<button class="to-top" type="button" data-back-to-top hidden aria-label="回到顶部" title="回到顶部">
  <span class="art">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path
        class="trail"
        d="M7.5 21.5C11 17.5 13 11 16.5 5"
        fill="none"
        stroke="var(--ink-soft)"
        stroke-width="1.5"
        stroke-linecap="round"
      />
      <g class="speed" stroke="var(--ink-soft)" stroke-width="1.7" stroke-linecap="square">
        <path d="M2.2 15.8 4.4 13.6" />
        <path d="M4 20.6 7.2 17.4" />
        <path d="M8.6 22.4 11.6 19.4" />
      </g>
      <g class="plane">
        <path
          class="wing"
          d="M20.6 3.4 14.3 21.4 10.7 13.3 2.6 9.7Z"
          fill="var(--blue)"
          stroke="var(--ink)"
          stroke-width="1.8"
          stroke-linejoin="miter"
        />
        <path
          d="M20.6 3.4 10.7 13.3"
          fill="none"
          stroke="var(--ink)"
          stroke-width="1.1"
          opacity="0.55"
        />
      </g>
    </svg>
  </span>
</button>

<script>
  /** 滚过这么多像素才出现（正文刚起步就露头，免得一滚动就跳出） */
  const SHOW_AFTER_PX = 400;
  const PAGE_TOP = 0;

  const btn = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (btn) {
    btn.hidden = false;
    let shown = false;

    /** 只在状态真变时动 DOM，避免每帧滚动都写 class */
    const setShown = (next: boolean) => {
      if (next === shown) return;
      shown = next;
      btn.classList.toggle("is-on", next);
    };

    const syncWithScroll = () => setShown(window.scrollY > SHOW_AFTER_PX);

    window.addEventListener("scroll", syncWithScroll, { passive: true });
    syncWithScroll();

    // 起飞动效播完再摘下状态（时长写在 CSS 的关键帧里，脚本不重复维护）
    btn.querySelector(".plane")?.addEventListener("animationend", () => {
      btn.classList.remove("is-play");
    });

    btn.addEventListener("click", () => {
      btn.classList.add("is-play");
      window.scrollTo({ top: PAGE_TOP, behavior: reduced ? "auto" : "smooth" });
    });
  }
</script>

<style>
  .to-top {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 45; /* 低于目录弹层（50） */
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 3px solid var(--ink);
    background: var(--card);
    box-shadow: 3px 3px 0 var(--ink);
    cursor: pointer;
    /* 出现/消失 = 贴纸弹上来（reduced-motion 由 global.css 全量关闭） */
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) rotate(-9deg) scale(0.82);
    transition:
      opacity 0.18s ease,
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.12s ease,
      visibility 0.18s ease;
  }
  /* 无 JS 时整个不渲染（脚本负责摘掉 hidden） */
  .to-top[hidden] {
    display: none;
  }
  .to-top.is-on {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .to-top.is-on:hover {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow);
  }
  .to-top.is-on:active {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  /* ── 图标：纸飞机 + 速度线 ── */
  .art {
    display: block;
    width: 26px;
    height: 26px;
  }
  .art svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible; /* 起飞时飞机要飞出按钮 */
  }
  .plane {
    transition: transform 0.18s ease;
  }
  .to-top:hover .plane {
    transform: translateY(-1.4px) rotate(-2deg);
  }
  .speed {
    opacity: 0.38;
    transition:
      opacity 0.18s ease,
      transform 0.18s ease;
  }
  .to-top:hover .speed {
    opacity: 1;
    transform: translate(-1px, 1px);
  }
  .trail {
    opacity: 0;
    stroke-dasharray: 2 3;
  }

  /* ── 点击：顺速度线射出按钮，虚线航迹跟着往上流 ── */
  .to-top.is-play .plane {
    animation: to-top-fly 0.5s cubic-bezier(0.32, 0.72, 0.36, 1) forwards;
  }
  .to-top.is-play .speed {
    animation: to-top-speed 0.5s ease forwards;
  }
  .to-top.is-play .trail {
    animation: to-top-trail 0.55s ease forwards;
  }
  @keyframes to-top-fly {
    to {
      transform: translate(11px, -15px) scale(0.62) rotate(-8deg);
      opacity: 0;
    }
  }
  @keyframes to-top-speed {
    35% {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translate(-3px, 3px);
    }
  }
  @keyframes to-top-trail {
    0% {
      opacity: 0;
      stroke-dashoffset: 0;
    }
    35% {
      opacity: 0.85;
    }
    to {
      opacity: 0;
      stroke-dashoffset: -26;
    }
  }

  /* ── 位置：窄屏让位于右下角的「目录」悬浮按钮 ──
     目录按钮只在真有目录时才显示（公开文章 directly / 私密文章解锁后加 .unlocked），
     所以用 :has 精确判断，别把按钮白抬高一格。 */
  @media (max-width: 1399px) {
    :global(body:has(.toc-fab:not(.deferred), .toc-fab.unlocked)) .to-top {
      bottom: 78px;
    }
  }
  /* ── 位置：≥1400px 目录变成右栏（无悬浮按钮），按钮与目录箱同左缘、贴视口底部 ── */
  @media (min-width: 1400px) {
    .to-top {
      right: auto;
      left: var(--toc-left);
      bottom: 26px;
    }
  }
</style>

---
import SocialIcon from "./SocialIcon.astro";

// 构建期年份：静态产物自带正确年份（无 JS 也成立）；跨年后由页尾内联脚本按浏览器时间修正
const buildYear = new Date().getFullYear();
---

<footer class="site-footer">
  <span>Copyright © <span data-year>{buildYear}</span> | All rights reserved.</span>

  <span class="meta">
    {/* RSS 与私密文章都是站点自带入口（不属「站点主人的社交账号」，不进 socials） */}
    <a class="feed-link" href="/rss.xml" title="订阅本站更新（RSS）">
      <SocialIcon icon={{ kind: "builtin", name: "rss" }} size={10} />
      RSS
    </a>

    <a class="private-link" href="/private" title="本站私密文章（需密码）">
      <svg class="seal-mark" viewBox="0 0 16 16" width="11" height="11" aria-hidden="true">
        <rect
          x="1.6"
          y="1.6"
          width="12.8"
          height="12.8"
          fill="var(--red)"
          stroke="var(--ink)"
          stroke-width="2.6"
        />
      </svg>
      私密文章
    </a>
  </span>
</footer>

<script is:inline>
  // 纯静态站不会自己翻年份：跨年后打开页面时按浏览器时间就地修正（不必重新部署）
  (function () {
    var el = document.querySelector("[data-year]");
    if (el) el.textContent = String(new Date().getFullYear());
  })();
</script>

<style>
  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 72px;
    padding: 15px 0 30px;
    border-top: 2px dashed var(--ink-soft);
    font-size: 12px;
    color: var(--ink-soft);
  }
  .site-footer .meta {
    display: inline-flex;
    align-items: center;
    /* 两个入口之间的唯一分隔：不留「·」，语言上也不成一句 */
    gap: 22px;
    row-gap: 4px;
    flex-wrap: wrap;
  }
  .site-footer a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    /* 行盒只有 21px，把可点区域撑到 24px（WCAG 2.5.8） */
    min-height: var(--touch-min);
    color: inherit;
    transition: color 0.2s ease;
  }
  .site-footer a:hover {
    color: var(--red-ink);
  }
  /* 私密文章的朱砂小方章（负 3° 与解锁页 .seal-stamp 同一手势；
     不叫 .seal——那是页头 logo 的名字） */
  .site-footer .seal-mark {
    flex: none;
    transform: rotate(-3deg);
    transition: transform 0.12s ease;
  }
  .site-footer .private-link:hover .seal-mark {
    transform: rotate(-3deg) scale(1.12);
  }
  /* RSS 图标取朱砂（与首页贴纸条上那一枚同色）。
     图标是满幅的，不像朱砂印章那样四周留边，所以在 24px 行盒里居中会往下坠半像素、
     看着跟文字没对齐：给它 1px 下外边距把 margin box 撑大，居中后正好上移 0.5px——
     不用亚像素 transform，图标不会被抹糊。 */
  .site-footer .feed-link :global(.ico) {
    color: var(--red-ink);
    margin-bottom: 1px;
  }
</style>

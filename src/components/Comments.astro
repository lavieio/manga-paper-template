---
/**
 * remark42 评论区（plan §11）
 * - 未配置 PUBLIC_REMARK42_HOST / PUBLIC_REMARK42_SITE_ID → 整块不渲染
 * - 懒加载：滚动接近评论区才注入 remark42 脚本（首屏零负担）
 * - 主题同步：remark42 在跨源 iframe 中渲染（样式隔离，无法用页面 CSS 覆盖），
 *   但官方支持 light/dark，我们跟随站点主题并在切换时调用 REMARK42.changeTheme
 * - 私密文章不渲染本组件（在 [slug].astro 的私密分支里就不存在）
 */
import { remark42, isRemark42Enabled } from "../config";

const { host, siteId } = remark42;
---

{
  isRemark42Enabled && host && siteId && (
    <section class="comments" data-pagefind-ignore>
      <div class="sec-head">
        <span class="sticker pink">评论</span>
        <span class="rule" />
      </div>
      <div id="remark42" data-comments-host data-host={host} data-site-id={siteId} />
    </section>
  )
}

<script>
  const LOAD_MARGIN = "200px";

  const hostEl = document.querySelector<HTMLElement>("[data-comments-host]");
  const host = hostEl?.dataset.host;
  const siteId = hostEl?.dataset.siteId;

  if (hostEl && host && siteId) {
    let loaded = false;

    const currentTheme = (): "light" | "dark" =>
      document.documentElement.dataset.theme === "dark" ? "dark" : "light";

    const inject = () => {
      if (loaded) return;
      loaded = true;
      const config = {
        host,
        site_id: siteId,
        url: window.location.origin + window.location.pathname,
        components: ["embed"],
        theme: currentTheme(),
        locale: "zh",
      };
      (window as unknown as { remark_config?: typeof config }).remark_config = config;

      // 与 remark42 官方 embed 片段一致：支持 module 时用 .mjs，否则 .js
      const target = document.head || document.body;
      for (const component of config.components) {
        const script = document.createElement("script");
        let ext = ".js";
        if ("noModule" in script) {
          script.type = "module";
          ext = ".mjs";
        } else {
          script.async = true;
        }
        script.defer = true;
        script.src = `${config.host}/web/${component}${ext}`;
        target.appendChild(script);
      }
    };

    // 滚动接近评论区时才加载 remark42 资源
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((en) => en.isIntersecting)) {
          inject();
          io.disconnect();
        }
      },
      { rootMargin: LOAD_MARGIN },
    );
    io.observe(hostEl);

    // 跟随站点明暗主题（remark42 就绪后提供 REMARK42.changeTheme）
    const remark42Global = () =>
      (window as unknown as { REMARK42?: { changeTheme?: (t: string) => void } }).REMARK42;
    new MutationObserver(() => {
      remark42Global()?.changeTheme?.(currentTheme());
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  }
</script>

<style>
  .comments {
    margin-top: 56px;
  }
  .sec-head {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 36px 0 22px;
  }
  .sec-head .rule {
    flex: 1;
    height: 3px;
    background: var(--ink);
  }
  .sticker {
    display: inline-block;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    color: var(--on-light-fill);
  }
  .sticker.pink {
    background: var(--pink);
    transform: rotate(1.2deg);
  }
</style>

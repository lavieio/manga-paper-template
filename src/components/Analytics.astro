---
/**
 * GA4 埋点（可选）。
 *
 * 只在 `src/layouts/Base.astro` 里按「已配置 + 生产构建 + 页面未被 noindex」三条件渲染，
 * 因此私密文章、/private、404 都不会被统计。
 * 加载策略：先建立 gtag 命令队列，再等**页面 load 之后的空闲**或**首次交互之后的空闲**
 * 才注入 gtag.js——实测（PSI 手机）它落地在主线程上花 230 ms，正好撞在用户最容易交互的时刻，
 * 是本站 TBT（220 ms）与 max-FID 的主要来源；推迟到 load 之后既让首屏不跟它抢带宽，
 * 也把它的长任务挤出 TBT 统计窗口。
 * 代价：`FALLBACK_MS` 内既没 load 完也没交互的访问（通常是秒退）不产生 page_view——
 * 想收齐秒退数据就把那个常量调小，想 TBT 更干净就调大。
 * 放行 gtag.js 与采集端点的 CSP 由 `src/utils/deploy/deploy-policy.ts` 按同一份 env 现算。
 */
import { analytics } from "../config";

const measurementId = analytics.gaMeasurementId;
/** 没等到交互时的兵底延时（load 之后算起）：调到 0 就退化成「load 完就加载」 */
const FALLBACK_MS = 5000;
/** 首次交互的种类：任何一种都说明用户真的在用这个页面 */
const INTERACTION_EVENTS = ["pointerdown", "keydown", "touchstart", "scroll"] as const;
---

{
  measurementId && (
    <script is:inline define:vars={{ measurementId, FALLBACK_MS, INTERACTION_EVENTS }}>
      // gtag 队列桩：脚本落地前先把命令攒进 dataLayer，gtag.js 加载后会回放
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag("js", new Date());
      window.gtag("config", measurementId);

      (function () {
        var loaded = false;

        function inject() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(measurementId);
          document.head.appendChild(s);
        }

        // 空闲回调带 timeout 兜底：后台标签页空闲回调可能长时间不触发
        function whenIdle(callback) {
          if ("requestIdleCallback" in window) window.requestIdleCallback(callback, { timeout: 4000 });
          else window.setTimeout(callback, 1000);
        }

        // 交互本身不能被打断：等这次交互处理完再进空闲回调，否则 INP 会替 TBT 买单
        INTERACTION_EVENTS.forEach(function (type) {
          window.addEventListener(type, function () {
            whenIdle(inject);
          }, { once: true, passive: true });
        });

        window.addEventListener(
          "load",
          function () {
            window.setTimeout(function () {
              whenIdle(inject);
            }, FALLBACK_MS);
          },
          { once: true },
        );
      })();
    </script>
  )
}

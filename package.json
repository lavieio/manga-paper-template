{
  "name": "manga-paper",
  "type": "module",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-site-url.ts && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "prepare": "husky",
    "verify": "node scripts/verify-dist.ts",
    "smoke": "node scripts/smoke-dist.ts",
    "check": "npm run build && npm test && npm run verify && npm run smoke"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "image-size": "^2.0.4",
    "photoswipe": "^5.4.4"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "pagefind": "^1.5.2"
  }
}
